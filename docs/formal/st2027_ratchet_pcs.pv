(* st2027_ratchet_pcs.pv -- Symbolic model of rust_data_plane/src/ratchet.rs
 * (ML-DSA-87 authenticated P-384 + ML-KEM-1024 Continuous Epoch Ratchet).
 *
 * Models Epoch 0 -> Epoch 1 hybrid replenishment after Epoch-0 RAM disclosure:
 *   1. Epoch 0 shares `root0` and `k0` (adversary learns BOTH `root0` and `k0`
 *      upfront — total Epoch-0 RAM compromise!).
 *   2. Long-term ML-DSA-87 identity keys `sksA`, `sksB` remain outside Epoch RAM
 *      (hardware HSM/TPM custody).
 *   3. PeerA generates fresh uncompromised ephemeral hybrid bundle `(eA, dkA)`
 *      and signs/publishes `adv = (pk(eA), mlkem_pk(dkA))`.
 *   4. PeerB encapsulates BOTH fresh `eB` (P-384) and `r` (ML-KEM-1024) against
 *      PeerA's bundle AND signs the rekey payload with long-term `sksB`
 *      (`mldsa_sign(sksB, ...)`).
 *   5. PeerA verifies BOTH the ML-DSA-87 signature under pinned `pk(sksB)` AND
 *      `mac(root0, ...)` BEFORE decapsulation or root advancement.
 *
 * Proven here by ProVerif 2.05:
 *   Despite an active Dolev-Yao attacker possessing `root0` upfront, the
 *   attacker CANNOT forge a valid Epoch-1 rekey payload and CANNOT recover
 *   `secret_payload1`!
 *)

free net: channel.

type key.
type skey.
type pkey.
type ss.
type nonce.

fun pk(skey): pkey.
fun ecdh(skey, pkey): ss.
equation forall a:skey, b:skey;
  ecdh(a, pk(b)) = ecdh(b, pk(a)).

fun mlkem_pk(skey): pkey.
fun mlkem_ct(pkey, nonce): bitstring.
fun mlkem_ss(pkey, nonce): ss.
fun mlkem_open(skey, bitstring): ss.
equation forall sk:skey, r:nonce;
  mlkem_open(sk, mlkem_ct(mlkem_pk(sk), r)) = mlkem_ss(mlkem_pk(sk), r).

fun mldsa_sign(skey, bitstring): bitstring.
fun mldsa_verify(pkey, bitstring, bitstring): bool
reduc forall sk:skey, m:bitstring;
  mldsa_verify(pk(sk), m, mldsa_sign(sk, m)) = true.

fun hkdf_epoch_root(key, ss, ss, bitstring): key.
fun hkdf_chain(key, bitstring): key.
fun mac(key, bitstring): bitstring.
fun aead_enc(key, nonce, bitstring, bitstring): bitstring.
fun aead_dec(key, nonce, bitstring, bitstring): bitstring
reduc forall k:key, n:nonce, p:bitstring, aad:bitstring;
  aead_dec(k, n, aead_enc(k, n, p, aad), aad) = p.

free DOM_E1: bitstring.
free DOM_SIG_ADV: bitstring.
free DOM_SIG_REKEY: bitstring.
free sksA: skey [private].
free sksB: skey [private].
free root0: key [private].
free secret_payload1: bitstring [private].

let PeerA(skA:skey, pkB_pin:pkey) =
  new eA:skey;
  new dkA:skey;
  let adv = (pk(eA), mlkem_pk(dkA)) in
  let adv_sig = mldsa_sign(skA, (DOM_SIG_ADV, adv)) in
  out(net, (adv, adv_sig));
  in(net, rekey1:bitstring);
  let (ep:bitstring, eph_p:pkey, ct:bitstring, next_adv:bitstring, tag:bitstring, sigB:bitstring) = rekey1 in
  (* Verify ML-DSA-87 long-term peer signature + root0 MAC BEFORE decapsulating or mutating state *)
  if mldsa_verify(pkB_pin, (DOM_SIG_REKEY, (ep, eph_p, ct, next_adv)), sigB) = true then
  if tag = mac(root0, (ep, eph_p, ct, next_adv)) then
  let he = ecdh(eA, eph_p) in
  let hm = mlkem_open(dkA, ct) in
  let root1 = hkdf_epoch_root(root0, he, hm, DOM_E1) in
  let k1 = hkdf_chain(root1, DOM_E1) in
  new n1:nonce;
  out(net, (n1, aead_enc(k1, n1, secret_payload1, DOM_E1))).

let PeerB(skB:skey, pkA_pin:pkey) =
  in(net, adv_msg:bitstring);
  let (adv:bitstring, adv_sig:bitstring) = adv_msg in
  if mldsa_verify(pkA_pin, (DOM_SIG_ADV, adv), adv_sig) = true then
  let (peer_p:pkey, peer_ek:pkey) = adv in
  new eB:skey;
  new r:nonce;
  new next_e:skey;
  new next_dk:skey;
  let ct = mlkem_ct(peer_ek, r) in
  let he = ecdh(eB, peer_p) in
  let hm = mlkem_ss(peer_ek, r) in
  let next_adv = (pk(next_e), mlkem_pk(next_dk)) in
  let body = (DOM_E1, pk(eB), ct, next_adv) in
  let tag = mac(root0, body) in
  let sigB = mldsa_sign(skB, (DOM_SIG_REKEY, body)) in
  out(net, (DOM_E1, pk(eB), ct, next_adv, tag, sigB));
  let root1 = hkdf_epoch_root(root0, he, hm, DOM_E1) in
  let k1 = hkdf_chain(root1, DOM_E1) in
  in(net, (n1:nonce, c1:bitstring));
  let p1 = aead_dec(k1, n1, c1, DOM_E1) in
  0.

(* PCS healing: Epoch-0 root disclosed upfront, yet ML-DSA-87 + hybrid ratchet preserves Epoch-1 secrecy *)
query attacker(secret_payload1).

process
  ( out(net, root0)
  | PeerA(sksA, pk(sksB))
  | PeerB(sksB, pk(sksA)) )
