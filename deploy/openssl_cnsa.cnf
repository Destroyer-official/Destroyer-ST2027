# =============================================================================
# Destroyer-ST2027 - OpenSSL CNSA 2.0 TLS posture overlay (P1, 2026-10-16)
# =============================================================================
# Usage (operator-level, fail-closed):
#   set OPENSSL_CONF=<absolute path to this file>   (Windows)
#   export OPENSSL_CONF=<absolute path to this file> (POSIX)
# OpenSSL reads OPENSSL_CONF at first ssl-module initialisation, so this must
# be present in the service environment BEFORE the process starts.
#
# What it enforces:
#   * TLS 1.3 only (Min/MaxProtocol) - no 1.2 fallback.
#   * RFC 9954/10024 hybrid key exchange GROUPS only - no classical-only
#     fallback in TLS 1.3 KEX. PQ KEX rides supported_groups/key_share,
#     never ciphersuite names; the TLS 1.3 ciphersuite
#     (TLS_AES_256_GCM_SHA384, CNSA 2.0) is pinned post-handshake in
#     tls_channel_manager.do_handshake().
#
# Empirically verified 2026-10-16 on the deployment stack (OpenSSL 3.5.7):
#   * default ClientHello offers X25519MLKEM768 (0x11EC);
#   * with Groups= restricted as below, only the listed groups are offered;
#   * hybrid-only server vs classical-only client => SSLV3_ALERT_HANDSHAKE_FAILURE
#     (fail-closed, no silent downgrade).
#
# Evidence/diagnostics: tls_pq_policy.client_offers_hybrid_group() and the
# "TLS PQ Posture" section of verify_deployment.py.
# =============================================================================

openssl_conf = default_conf

[default_conf]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1.3
MaxProtocol = TLSv1.3
Groups = X25519MLKEM768:SecP384r1MLKEM1024:SecP256r1MLKEM768
