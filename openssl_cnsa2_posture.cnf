# ============================================================================
# Destroyer-ST2027 CNSA 2.0 / DoD Zero-Trust OpenSSL Configuration Template
# ============================================================================
# Enforces RFC 10024 / NIST Level 5 Post-Quantum Hybrid TLS 1.3 Groups
# and CNSA 2.0 Suite: TLS_AES_256_GCM_SHA384 (0x1302).
#
# Usage:
#   Set environment variable OPENSSL_CONF to the absolute path of this file:
#   export OPENSSL_CONF=/path/to/openssl_cnsa2_posture.cnf   (Linux/macOS)
#   set OPENSSL_CONF=D:\path\to\openssl_cnsa2_posture.cnf   (Windows CMD)
#   $env:OPENSSL_CONF="D:\path\to\openssl_cnsa2_posture.cnf" (PowerShell)
# ============================================================================

openssl_conf = default_conf

[default_conf]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
# Strict TLS 1.3 enforcement (CNSA 2.0 mandate; no downgrade permitted)
MinProtocol = TLSv1.3
MaxProtocol = TLSv1.3

# CNSA 2.0 Profile Cipher Suite: 256-bit AES-GCM with SHA-384
CipherSuites = TLS_AES_256_GCM_SHA384

# Named Groups ladder: NIST Level 5 Hybrid (SecP384r1MLKEM1024) preferred,
# followed by Level 3 Hybrid (X25519MLKEM768) and classical P-384 fallback.
Groups = SecP384r1MLKEM1024:X25519MLKEM768:secp384r1

# Signature Algorithms: ML-DSA-87 (FIPS 204 Level 5) and P-384
SignatureAlgorithms = mldsa87:ecdsa_secp384r1_sha384
